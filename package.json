{
  "name": "aruizca-resume",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered resume and cover letter generator",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "setup": "pnpm install && pnpm install --filter=\"./packages/*\"",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:core": "pnpm --filter @aruizca-resume/core run build:watch",
    "dev:webapp": "pnpm --filter @aruizca-resume/webapp run dev",
    "dev:api": "pnpm --filter @aruizca-resume/api run dev",
    "start:dev": "pnpm --filter @aruizca-resume/webapp run build && pnpm --filter @aruizca-resume/api run dev",
    "start": "pnpm build && pnpm --filter @aruizca-resume/api run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "concurrently": "^8.2.2"
  }
}
