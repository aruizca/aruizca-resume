{
  "name": "aruizca-resume",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered resume and cover letter generator",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start": "pnpm --filter @aruizca-resume/core run build && node --env-file=.env packages/core/dist/resume.js",
    "start:fresh": "pnpm --filter @aruizca-resume/core run build && node --env-file=.env packages/core/dist/resume.js --force-refresh",
    "cover-letter": "pnpm --filter @aruizca-resume/core run build && node --env-file=.env packages/core/dist/cover-letter.js",
    "pdf": "node packages/core/src/main/shared/infrastructure/pdf/playwright-pdf.js"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
