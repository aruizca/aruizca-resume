{
  "type": "module",
  "scripts": {
    "build": "esbuild src/main/resume-generator.ts --bundle --platform=node --format=esm --outfile=dist/resume-generator.js && esbuild src/main/cover-letter-generator.ts --bundle --platform=node --format=esm --outfile=dist/cover-letter-generator.js",
    "start": "npm run build && node --env-file=.env dist/resume-generator.js",
    "start:fresh": "npm run build && node --env-file=.env dist/resume-generator.js --force-refresh",
    "cover-letter": "npm run build && node --env-file=.env dist/cover-letter-generator.js",
    "pdf": "node src/main/playwright-pdf.js",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:watch": "vitest",
    "test:watch:unit": "vitest src/test/unit"
  },
  "dependencies": {
    "@jsonresume/schema": "^1.2.1",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.3",
    "ajv": "^8.17.1",
    "jsonresume-theme-even": "^0.23.0",
    "langchain": "^0.3.30",
    "papaparse": "^5.5.3",
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/papaparse": "^5.3.16",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
