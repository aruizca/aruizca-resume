{
  "name": "aruizca-resume",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered resume and cover letter generator",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm install --filter=\"./packages/*\"",
    "build": "turbo run build",
    "build:check": "turbo run build:check",
    "dev": "pnpm run build && pnpm --filter @aruizca-resume/api run dev",
    "watch": "turbo watch build:watch dev",

    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
