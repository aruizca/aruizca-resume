{
  "type": "module",
  "scripts": {
    "build": "esbuild src/main/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js",
    "start": "npm run build && node --env-file=.env dist/main.js",
    "pdf": "node src/main/playwright-pdf.js",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:watch": "vitest",
    "test:watch:unit": "vitest src/test/unit"
  },
  "dependencies": {
    "@jsonresume/schema": "^1.2.1",
    "ajv": "^8.17.1",
    "jsonresume-theme-even": "^0.23.0",
    "openai": "^5.9.0",
    "papaparse": "^5.5.3",
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/papaparse": "^5.3.16",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
